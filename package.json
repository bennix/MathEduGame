{
  "name": "mathgame",
  "version": "1.0.1",
  "description": "A hand-drawn mathematical arcade shooter",
  "author": {
    "name": "ZHIPING XU",
    "email": "bennix@users.noreply.github.com"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac dmg --universal --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:linux": "npm run build && electron-builder --linux deb rpm --x64 --publish never",
    "test": "node --test"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.mathgame.zerosum",
    "productName": "MathGame",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "identity": "ZHIPING XU (5N66S29EK2)",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "MathGame ${version}"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "deb",
        "rpm"
      ],
      "icon": "build/icon.png",
      "category": "Game"
    }
  }
}
